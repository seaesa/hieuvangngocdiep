# URL gọn cho hosting Apache / cPanel
Options -MultiViews
DirectorySlash Off
RewriteEngine On

# 1) /slug/index.html -> /slug  (chỉ áp dụng cho request gốc từ trình duyệt, tránh vòng lặp)
RewriteCond %{THE_REQUEST} \s/+(.+?)/index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# 2) /slug/ -> /slug
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 3) Link cũ dạng .html
RewriteRule ^(gioi-thieu|san-pham)\.html$ /$1 [R=301,L,NC]

# 4) /slug -> phục vụ nội dung slug/index.html (URL giữ nguyên)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ /$1/index.html [L]
